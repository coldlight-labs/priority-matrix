# Copy to deploy/.env on the VPS (git-ignored) and set your own addresses (#74).
# The app's address, for example a subdomain of your domain.
SITE_ADDRESS=matrix.example.com
# Your main domain; it and its www are sent to the app until it has its own site.
MAIN_ADDRESS=example.com
# A second app sharing the front door (ADR 0008): its address, and its container's
# name and port on the shared "edge" network.
EXTRA_SITE_ADDRESS=app2.example.com
EXTRA_SITE_UPSTREAM=app2-web:3000
