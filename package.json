{
  "name": "priority-matrix",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:site": "tsc --noEmit && vite build --mode site",
    "dev:server": "npm run build:server && node dev/make-dev-data.ts && DATA_DIR=$PWD/.dev-data BASE_URL=http://localhost:5174 PORT=8787 node dist-server/main.js",
    "dev:site": "vite --mode site --port 5174 --strictPort",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "imports": "depcruise src server --config .dependency-cruiser.cjs",
    "private-words": "bash tools/check-private-words.sh",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run imports && npm run private-words && npm run test && npm run build && npm run build:site && npm run build:server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
